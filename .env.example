# Opt-in, local-only development runtime. Production access is blocked by the server.
ENABLE_LOCAL_RUNTIME=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visual_studio_dev
DB_USER=visual_studio_dev
DB_PASSWORD=replace_this_with_your_local_database_password
# Login users are created with `npm run auth:user` (local .vas/users.local.json).
# No password or session signing key is stored in this environment file.
